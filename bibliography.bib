@article{rothsteinAdverbialQuantificationEvents1995,
    title = {Adverbial Quantification over Events},
    author = {Rothstein, Susan},
    date = {1995-02-01},
    journaltitle = {Natural Language Semantics},
    shortjournal = {Nat. Lang. Semant.},
    volume = {3},
