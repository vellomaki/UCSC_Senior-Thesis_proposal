    location = {United States -- New York},
    url = {
           https://www.proquest.com/docview/304243269/abstract/EEAB9F9A3CE44578PQ/1
           },
    urldate = {2025-11-28},
    abstract = {This dissertation investigates the structural and interpretive
                aspects of the Head-Internal Relative Clause (henceforth, HIRC)
                construction and the Head-External Relative Clause (henceforth,
                HERC) construction within the Principles-and-Parameters Approach
                with reference to Japanese, English, and Basque. Specifically, we
                will explore the following questions throughout this
                dissertation: (i) Is there really a single and uniform
                grammatical process of relativization involving an overt or null
                operator movement in natural language? (ii) What is/are the
                underlying licensing mechanism(s) of each type of relativization
                in natural language? With respect to the question (i), the
                present investigation will clearly demonstrate that there is in
                fact no single and uniform grammatical process of relativization
                which employs an overt or null operator movement in natural
                language. Furthermore, in this connection, it will be claimed
                that what has been standardly called an operator movement in
                relativization is not an operator movement at all. As for the
                question (ii), we will show the following points in this
                dissertation. First, the HIRC construction involves an empty
                argument NP (e) which functions as an E-Type pronoun in the sense
                of Evans (1977a,b; 1980) and Cooper (1979). By extending and
                modifying Cooperian treatment of E-Type pronouns in English, we
                will show that all the relevant properties of the HIRC follow
                from our analysis. In the case of the HERC construction, we will
                deal with both the restrictive relative clause and the
                non-restrictive relative clause. With respect to the restrictive
                relative clause, we will claim that the essential underlying
                licensing mechanism is the determiner-operator binding at LF
                along the lines of Reinhart (1987) by closely examining English,
                Basque, and Japanese. As for the non-restrictive relative clause,
                we will claim that the relative pronoun of the non-restrictive
                relative clause has E-Type pronoun properties in general on the
                basis of English and Japanese, providing further support to Sells
                (1985a,b; 1986) and Demirdache (1991).},
    isbn = {979-8-6415-5983-4},
    langid = {english},
    pagetotal = {280},
    keywords = {Basque,English,IHRC,internally headed relative clause,Japanese,
                Language literature and linguistics,Linguistics,Relative Clause},
    file = {/Users/ben/Zotero/storage/B4I7NDQG/Hoshi - 1995 - Structural and
            interpretive aspects of head-internal and head-external relative
            clauses.pdf},
}

